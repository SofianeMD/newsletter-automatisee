# Copier ce fichier en ".env" et remplir les valeurs. Ne jamais committer le vrai .env.

# URL du webhook (Paramètres du canal > Intégrations > Webhooks > Copier l'URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxx

# Chemins des fichiers ; {date} est remplacé par AAAA-MM-JJ (heure de Paris)
PDF_PATH=output/{date}/newsletter.pdf
TXT_PATH=output/{date}/newsletter.txt

# Optionnel
MAX_FILE_MB=10
SUPPRESS_EMBEDS=true
LOG_FILE=logs/discord.log
